# Copy to .env.local for local development.
# Both values are PUBLIC by design (Supabase "anon" key). Data is protected by Row Level Security.
# NEVER put the service_role key into this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public site address (used in sitemap, canonical links and Open Graph)
NEXT_PUBLIC_SITE_URL=https://zavars296-cyber.github.io/semitsvetik
# Sub-path when hosted at https://user.github.io/<repo>/ . Leave empty on Vercel or a custom domain.
NEXT_PUBLIC_BASE_PATH=/semitsvetik
